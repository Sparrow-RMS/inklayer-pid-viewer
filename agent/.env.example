OPENAI_API_KEY=
# Where `hazop-agent serve` listens (defaults 127.0.0.1 and 4002). The viewer's
# dev server (npm run dev) reads AGENT_PORT from here too, to proxy /agent to it.
AGENT_HOST=
AGENT_PORT=
# API keys (comma-separated). Set any, and every /agent call must send one as
# `Authorization: Bearer <key>` or `X-API-Key: <key>`; /agent/health and the
# API docs (/agent/docs) stay open. Leave empty only on a machine nobody else
# can reach. One key per app makes revoking one easy. Make them long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEYS=
# Browser origins allowed to call the agent from another site (comma-separated),
# e.g. the viewer at https://hazop.example.com. Not needed when the viewer and
# the agent share one site, nor for server-to-server integrations.
AGENT_CORS_ORIGINS=
# The 3D plant view (plant3d.py) uses Claude: set ANTHROPIC_API_KEY, or run
# `ant auth login`. PLANT3D_MODEL defaults to claude-opus-5-5.
# Left commented: an empty key would hide an `ant auth login` profile.
# ANTHROPIC_API_KEY=
PLANT3D_MODEL=
# Which model API marks the nodes (steps 1-3, consolidation, worksheet drafts):
# openai (default) or anthropic. Claude's results are kept apart from OpenAI's
# in each job (under anthropic/), so `uv run hazop-agent compare <jobId>` can
# set the two side by side. The chat assistant stays on OpenAI either way.
PIPELINE_PROVIDER=
# OpenAI model for every structured-output call (default gpt-5.6).
PIPELINE_MODEL=
# Claude settings when PIPELINE_PROVIDER=anthropic (needs ANTHROPIC_API_KEY):
# model (default claude-opus-5-5), effort (low|medium|high|xhigh|max, default
# high), and output tokens per call (default 64000, up to 128000).
ANTHROPIC_PIPELINE_MODEL=
ANTHROPIC_PIPELINE_EFFORT=
ANTHROPIC_PIPELINE_MAX_TOKENS=
# Per-call timeout in seconds (default 600). Raise it for slow reasoning models.
PIPELINE_TIMEOUT=
# Where job artifacts, worksheets and chats live (default ../data/jobs).
PIPELINE_JOBS_DIR=
# LangSmith tracing (off unless LANGSMITH_TRACING=true). Traces include the
# rendered drawing images sent to the model, so they can be large.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hazop-agent
